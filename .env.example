# ===============================================
# Environment Variables Example for JDP Tools
# ===============================================
# Salin file ini menjadi .env di server:
# cp .env.example .env

# Port aplikasi di host VPS (default: 80 untuk HTTP langsung)
# Jika port 80 sudah digunakan oleh Nginx bawaan VPS, ganti misal ke 3000 atau 8080
APP_PORT=80

# Environment Mode
NODE_ENV=production

# ===============================================
# Konfigurasi Database (MariaDB / MySQL)
# ===============================================
# Nama database aplikasi
DB_NAME=jdp_tools_db

# User database biasa untuk aplikasi
DB_USER=jdp_user

# Password untuk user aplikasi (GANTI dengan password aman!)
DB_PASSWORD=GantiPasswordUser123!

# Password untuk root database (GANTI dengan password aman!)
DB_ROOT_PASSWORD=GantiPasswordRoot123!
